# A comma-separated list of access keys. Example: `ACCESS_KEYS="ABC123,JUD71F,HUWE3"`. Leave blank for unrestricted access.
ACCESS_KEYS=""

# The timeout in hours for access key validation. Set to 0 to require validation on every page load.
ACCESS_KEY_TIMEOUT_HOURS="24"

# The default model ID for Wllama in browsers without WebGPU, where the model runs on the CPU.
WLLAMA_DEFAULT_MODEL_ID="littlelamb-290m"

# The default model ID for Wllama in browsers with WebGPU.
WLLAMA_DEFAULT_GPU_MODEL_ID="gemma-3-4b"

# The base URL for the internal OpenAI compatible API. Example: `INTERNAL_OPENAI_COMPATIBLE_API_BASE_URL="https://api.openai.com/v1"`. Leave blank to disable internal OpenAI compatible API.
INTERNAL_OPENAI_COMPATIBLE_API_BASE_URL=""

# The access key for the internal OpenAI compatible API.
INTERNAL_OPENAI_COMPATIBLE_API_KEY=""

# The model for the internal OpenAI compatible API.
INTERNAL_OPENAI_COMPATIBLE_API_MODEL=""

# The context window, in tokens, of the internal OpenAI compatible API's models. The browser sizes the search results, page excerpts, chat history and the answer's `max_tokens` from it. Leave blank for 131072 (128K).
INTERNAL_OPENAI_COMPATIBLE_API_CONTEXT_LENGTH=""

# The reasoning effort for the internal OpenAI compatible API, sent as `reasoning_effort` (e.g. "none", "low", "medium", "high"). Leave blank to use the API's default.
INTERNAL_OPENAI_COMPATIBLE_API_REASONING_EFFORT=""

# The name of the internal OpenAI compatible API, displayed in the UI.
INTERNAL_OPENAI_COMPATIBLE_API_NAME="Internal API"

# The type of inference to use by default. The possible values are:
# "browser" -> In the browser
# "openai" -> Remote Server (OpenAI-compatible API)
# "horde" -> AI Horde
# "internal" -> $INTERNAL_OPENAI_COMPATIBLE_API_NAME
DEFAULT_INFERENCE_TYPE="browser"

# Comma-separated list of the origins allowed to receive the search query when MiniSearch is embedded in an iframe, such as a Hugging Face Space. The query is posted to each one, and the browser delivers it only when the embedding page is on that origin. Leave blank to never post it.
PARENT_WINDOW_ORIGINS="https://huggingface.co"

# Whether a text search that failed on SearXNG is retried against the second search providers (search.parallel.ai and You.com, tried one after the other in random order until one returns results). Only "true" or "1" turn it on.
SEARCH_FALLBACK_ENABLED="false"

# Comma-separated list of the second search providers to try: "parallel", "youcom", "keenable", or any mix. Empty means all three: Parallel, You.com and Keenable. With the fallback enabled, an unknown name stops the server at start.
SEARCH_FALLBACK_PROVIDERS=""

# The API key for Parallel (search.parallel.ai). Optional; without it the keyless tier is used, which Parallel describes as for exploration and light use.
SEARCH_FALLBACK_PARALLEL_API_KEY=""

# The API key for You.com. Optional; without it the keyless "profile=free" endpoint is used, which allows 100 queries per day.
SEARCH_FALLBACK_YOUCOM_API_KEY=""

# The API key for Keenable (api.keenable.ai), sent as X-API-Key. Optional; without it Keenable uses the keyless "mcp-public" endpoint, like the other keyless tiers.
SEARCH_FALLBACK_KEENABLE_API_KEY=""

# Whether a search that asks for an official page may run a second, "site:"-scoped query to reach the official site itself. Off by default, since it sends the engines a second request; only "true" or "1" turn it on.
SEARCH_OFFICIAL_LANE_ENABLED="false"
