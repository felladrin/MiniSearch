  "flows": [
    {
      "id": "search-and-answer",
      "title": "A search with an AI answer",
      "summary": "What happens between pressing Enter and reading a cited answer.",
      "delta": "unchanged",
      "participants": [
        {
          "node": "indexeddb"
        },
        {
          "node": "search-ui"
        },
        {
          "node": "in-browser-model"
        },
        {
          "node": "app-server"
        },
        {
          "node": "reranker"
        },
        {
          "node": "searxng"
        },
        {
          "node": "web"
        }
      ],
      "messages": [
        {
          "id": "cache-lookup",
          "from": "search-ui",
          "to": "indexeddb",
          "label": "look up cached results",
          "kind": "sync",
          "delta": "unchanged"
        },
        {
          "id": "cache-miss",
          "from": "indexeddb",
          "to": "search-ui",
          "label": "nothing fresh",
          "kind": "return",
          "delta": "unchanged"
        },
        {
          "id": "search-request",
          "from": "search-ui",
          "to": "app-server",
          "label": "GET /search/text",
          "kind": "sync",
          "delta": "unchanged"
        },
        {
          "id": "metasearch",
          "from": "app-server",
          "to": "searxng",
          "label": "query",
          "kind": "sync",
          "delta": "unchanged"
        },
        {
          "id": "fan-out",
          "from": "searxng",
          "to": "web",
          "label": "ask each engine",
          "kind": "sync",
          "delta": "unchanged",
          "repeat": 3
        },
        {
          "id": "engine-results",
          "from": "web",
          "to": "searxng",
          "label": "results",
          "kind": "return",
          "delta": "unchanged"
        },
        {
          "id": "merged-results",
          "from": "searxng",
          "to": "app-server",
          "label": "merged results",
          "kind": "return",
          "delta": "unchanged"
        },
        {
          "id": "rerank",
          "from": "app-server",
          "to": "reranker",
          "label": "score against the query",
          "kind": "sync",
          "delta": "unchanged"
        },
        {
          "id": "ranked",
          "from": "reranker",
          "to": "app-server",
          "label": "best first, weak ones dropped",
          "kind": "return",
          "delta": "unchanged"
        },
        {
          "id": "search-response",
          "from": "app-server",
          "to": "search-ui",
          "label": "ranked results",
          "kind": "return",
          "delta": "unchanged"
        },
        {
          "id": "cache-write",
          "from": "search-ui",
          "to": "indexeddb",
          "label": "cache for 15 minutes",
          "kind": "async",
          "delta": "unchanged"
        },
        {
          "id": "prompt",
          "from": "search-ui",
          "to": "in-browser-model",
          "label": "question + top results",
          "kind": "sync",
          "delta": "unchanged"
        },
        {
          "id": "answer",
          "from": "in-browser-model",
          "to": "search-ui",
          "label": "cited answer, streamed",
          "kind": "return",
          "delta": "unchanged"
        },
        {
          "id": "save-answer",
          "from": "search-ui",
          "to": "indexeddb",
          "label": "save to history",
          "kind": "async",
          "delta": "unchanged"
        }
      ]
    }
  ],
