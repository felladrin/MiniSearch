legacy-peer-deps = true
min-release-age = 3

# Install-script policy lives in package.json#allowScripts, not here: the
# .npmrc layer can only allow packages (it cannot express a deny), and a
# package.json policy outranks it and silences it with a warning, so
# package.json is the single source of truth. The per-package decisions
# (onnxruntime-node denied for GHSA-vwc7-r8mq-g2x9, protobufjs denied,
# fsevents allowed pinned) are documented in .github/SECURITY.md.
# Strict mode turns any install script without a recorded decision into a
# failed install instead of a warning.
strict-allow-scripts = true
